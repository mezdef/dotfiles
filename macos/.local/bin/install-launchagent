#!/bin/bash
# Renders each plist's @HOME@ into ~/Library/LaunchAgents and (re)loads it.
# Usage: install-launchagent ~/dotfiles/macos/Library/LaunchAgents/*.plist
set -euo pipefail

dst_dir="$HOME/Library/LaunchAgents"
domain="gui/$(id -u)"
mkdir -p "$dst_dir"

for src in "$@"; do
  label="$(basename "$src" .plist)"
  dst="$dst_dir/$label.plist"
  launchctl bootout "$domain/$label" 2>/dev/null || true
  # Replace, never write through, an old stow symlink into the repo.
  rm -f "$dst"
  sed "s#@HOME@#$HOME#g" "$src" > "$dst"
  plutil -lint -s "$dst"
  launchctl bootstrap "$domain" "$dst"
  echo "loaded $label"
done
