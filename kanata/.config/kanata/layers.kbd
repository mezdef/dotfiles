;; Layer mappings
;;
;; All deflayermap blocks must be in one file per layer name.
;; Aliases referenced here are defined in hyper.kbd and home-row-mods.kbd.

(deflayermap (base)
  ;; Hyper key (defined in hyper.kbd)
  caps @hyper

  ;; Home row mods — urob's "timeless" pattern
  ;;
  ;; Template args:
  ;;   $tot           tap-repress-timeout (re-press window for repeats)
  ;;   $hold-timeout  uniform hold-timeout (175ms)
  ;;   <key>          letter to type on tap
  ;;   <modifier>     hold action
  ;;   <non-hrm>      same-hand non-HRM keys → instant tap on press
  ;;   <hrm>          same-hand HRM keys → release-order resolution
  ;;
  ;; Same-hand mod combos (cmd+s, alt+f, etc.):
  ;;   hold the HRM key, press the target letter, release the HRM key first
  ;;   → hold fires (mod combo). Release the target first → tap roll.
  ;; Opposite-hand combos: instant hold on second-key release.
  ;;
  ;; All modifiers use left variants (lsft, lctl, lmet, lalt) — right
  ;; variants don't work in Ghostty/macOS terminal input.
  ;; HRMs temporarily disabled — home-row keys are bare letters.
  ;; Re-enable: `jj abandon` this changeset (or restore the block below).
  ;;   f @hrm-f
  ;;   j @hrm-j
  ;;   a (t! homerowmodfiltered $tot $hold-timeout a (multi lctl (layer-while-held ctrl)) $hrm-a-nonhrm $hrm-a-hrm)
  ;;   ; (t! homerowmodfiltered $tot $hold-timeout ; (multi lctl (layer-while-held ctrl)) $hrm-sc-nonhrm $hrm-sc-hrm)
  ;;   d (t! homerowmodfiltered $tot $hold-timeout d lmet $hrm-d-nonhrm $hrm-d-hrm)
  ;;   k (t! homerowmodfiltered $tot $hold-timeout k lmet $hrm-k-nonhrm $hrm-k-hrm)
  ;;   s (t! homerowmodfiltered $tot $hold-timeout s lalt $hrm-s-nonhrm $hrm-s-hrm)
  ;;   l (t! homerowmodfiltered $tot $hold-timeout l lalt $hrm-l-nonhrm $hrm-l-hrm)
  f f  j j
  a a  ; ;
  d d  k k
  s s  l l

  ;; Every letter triggers typing layer
  q (multi q @.tp) w (multi w @.tp) e (multi e @.tp)
  r (multi r @.tp) t (multi t @.tp) y (multi y @.tp)
  u (multi u @.tp) i (multi i @.tp) o (multi o @.tp)
  p (multi p @.tp) g (multi g @.tp) h (multi h @.tp)
  z (multi z @.tp) x (multi x @.tp) c (multi c @.tp)
  v (multi v @.tp) b (multi b @.tp) n (multi n @.tp)
  m (multi m @.tp)
  , (multi , @.tp) . (multi . @.tp) / (multi / @.tp)

  ;; Space exits typing layer
  spc @.spc

  ;; Fix ISO/ANSI: virtual HID interprets grv as § on ISO layout
  grv 102d
  102d grv

  ;; Media keys (matching MacBook F-key layout)
  f1  brdn
  f2  brup
  f7  prev
  f8  pp
  f9  next
  f10 mute
  f11 voldwn
  f12 volu
)

;; Hyper layer — active while caps (hyper) is held.
;; Bypasses HRM tap-hold so hyper shortcuts fire instantly.
;; f/j keep shift via tap-hold-press (no achordion) for hyper+shift combos.
(deflayermap (hyper)
  f (tap-hold-press 200 100 f lsft)
  j (tap-hold-press 200 100 j lsft)
  a a s s d d
  k k l l ; ;

  ;; Top/bottom of page (see scroll.kbd)
  g @scroll-goto
)

;; Ctrl layer — active while A or ; (home row ctrl) is held.
;; Remaps u/d to Page Up/Down for universal scrolling.
;; All other keys fall through with lctl held (normal Ctrl+key behavior).
(deflayermap (ctrl)
  u (unmod pgup)
  d (unmod pgdn)
)

(deflayermap (typing)
  ;; Each letter re-triggers @.tp so hold-for-duration re-arms the dwell.
  ;; Effect: sustained typing keeps the layer alive until a >dwell-ms gap.
  ;;
  ;; F/J are bare letters here (not @hrm-f / @hrm-j) — shift HRMs do NOT
  ;; persist into typing bursts. Trade-off: inline mid-burst capitalization
  ;; requires pausing past the dwell to drop back to base layer. Benefit:
  ;; eliminates the ENTIRE class of f/j shift misfires on words like
  ;; "of", "if", "off", "fix", "fox", "jump", etc. (Capital letters at
  ;; the start of a word still work — typing layer drops on space.)
  a (multi a @.tp) b (multi b @.tp) c (multi c @.tp) d (multi d @.tp)
  e (multi e @.tp) f (multi f @.tp) g (multi g @.tp) h (multi h @.tp)
  i (multi i @.tp) j (multi j @.tp) k (multi k @.tp) l (multi l @.tp)
  m (multi m @.tp) n (multi n @.tp) o (multi o @.tp) p (multi p @.tp)
  q (multi q @.tp) r (multi r @.tp) s (multi s @.tp) t (multi t @.tp)
  u (multi u @.tp) v (multi v @.tp) w (multi w @.tp) x (multi x @.tp)
  y (multi y @.tp) z (multi z @.tp)
  , (multi , @.tp) . (multi . @.tp) / (multi / @.tp)
  caps @hyper
  spc @.spc
  grv 102d
  102d grv
)
